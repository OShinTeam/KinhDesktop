<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="kinh-desktop.exe"
        Arguments=""
        InstallLocation="C:\Program Files\OshinTeam\KinhDesktop">
    </Installer>
    <PackageInformation
        PackageName="KinhDesktop"
        PackageDisplayName="KinhDesktop"
        PublisherName="CN=OshinTeam"
        PublisherDisplayName="OshinTeam"
        Version="0.1.0.0"
        PackageDescription="KinhWeb 桌面客户端">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.oshinteam.kinhdesktop"
                Description="KinhWeb 桌面客户端"
                DisplayName="KinhDesktop"
                ExecutableName="kinh-desktop.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>KinhDesktop</DisplayName>
            <PublisherDisplayName>OshinTeam</PublisherDisplayName>
            <Description>KinhWeb 桌面客户端</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="kinh-desktop.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
